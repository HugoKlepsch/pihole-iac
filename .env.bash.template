export TZONE="America/Toronto"

# Lock Pi-hole down to one network interface. Needed on a host with a public IP (e.g. a VPN server).
# Leave commented out on a LAN host behind a router, where Pi-hole answers on every interface.
# The host firewall also needs rules for these ports, see README.md.
# Settings: https://docs.pi-hole.net/ftldns/configfile/
#
# DNS (53): bind only to the VPN interface (loopback is added automatically)
#export FTLCONF_dns_listeningMode="bind"
#export FTLCONF_dns_interface="wg0"
# Web UI: VPN address only. 80/443 belong to the host's own web server; the internal Caddy proxies to 5380.
# No 'o' (optional) suffix, so a port that can't be bound is logged as an error with the reason.
#export FTLCONF_webserver_port="10.8.0.1:5380,10.8.0.1:53443s"
# NTP server (123): on by default and listens on all addresses
#export FTLCONF_ntp_ipv4_active="false"
#export FTLCONF_ntp_ipv6_active="false"
# Start after (and restart along with) the VPN, so the interface exists when Pi-hole binds to it.
# Re-run create-systemd-service.sh after changing this.
#export SYSTEMD_REQUIRES="wg-quick@wg0.service"
